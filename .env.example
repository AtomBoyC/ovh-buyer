# ============================================================
# OVH Sniper 环境变量配置模板（复制为 .env 使用）
# ============================================================

# Web 控制台监听端口（Docker 宿主机映射端口也会使用此值）
PORT=8888
HOST=0.0.0.0
TZ=Asia/Shanghai

# 可选：Docker Compose 镜像源（默认拉取 GHCR，取消注释可改用 Docker Hub 或固定版本）
# OVH_IMAGE=atomboyc/ovh-buyer:latest
# OVH_IMAGE=ghcr.io/atomboyc/ovh-buyer:2.2.0

# 可选：Docker 容器运行与数据卷归属 UID/GID（默认 1000:1000）
# PUID=1000
# PGID=1000

# 【强烈建议】面板登录密码 / API Key（部署在公网 Linux 服务器时务必设置！）
PANEL_PASSWORD=change_me_to_a_strong_password

# 可选：数据库凭据静态加密密钥（设置后 OVH 密钥将加密存储；注意修改会导致旧密文无法解密）
# DATA_ENCRYPTION_KEY=your_random_32_char_secret

# 可选：无头模式（仅后台抢购 + Telegram Bot，不开放 Web 端口）
# HEADLESS=false

# ---------------- 首次启动自动导入默认 OVH 账号（可选，也可在 Web 面板添加多个账号） ----------------
# 推荐在 Web 面板「多账号管理」点击最小权限一键申请链接（绝不申请删机/重启权限）
# 申请 Token 入口:
#   EU: https://eu.api.ovh.com/createToken/
#   CA: https://ca.api.ovh.com/createToken/
#   US: https://api.us.ovhcloud.com/createToken/
# 最小权限清单: GET /me, GET /me/*, GET/POST/PUT/DELETE /order/*, GET /dedicated/server, GET /dedicated/server/*
# OVH_ACCOUNT_NAME=我的IE主号
# OVH_ENDPOINT=ovh-eu
# OVH_SUBSIDIARY=IE
# OVH_APP_KEY=
# OVH_APP_SECRET=
# OVH_CONSUMER_KEY=

# ---------------- 通知渠道（可选，亦可在 Web 面板动态修改） ----------------
# Telegram（内置 Long Polling，无需公网 HTTPS 域名即可点击按钮一键下单！）
# TELEGRAM_CHAT_ID 支持逗号分隔多个，且支持直接推入超级群组的指定 Topic（话题）：
#   写法 1: -1002134567890/45 （或直接粘贴右键复制的话题链接 https://t.me/c/2134567890/45）
#   写法 2: TELEGRAM_CHAT_ID=-1002134567890 搭配 TELEGRAM_TOPIC_ID=45
# TELEGRAM_ADMIN_IDS 可填你自己的个人 User ID（用于在群组话题内点按钮/发指令授权，且不会向你私聊重复推送）
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TOPIC_ID=
# TELEGRAM_ADMIN_IDS=
# TELEGRAM_PROXY=

# 监控专用代理池（支持逗号或换行分隔多条；支持 http://, https://, socks5:// 及 ip:port:user:pass）
# - OVH_MONITOR_PROXIES_POOL: 两级自动优选总池（配合面板开启 proxy_auto_pool，自动串行测速挑最快 Top-N 进活跃池）
# - OVH_MONITOR_PROXIES: 手动固定轮询监控代理列表
# OVH_MONITOR_PROXIES_POOL=socks5://user:pass@1.2.3.4:1080,http://user:pass@5.6.7.8:8080
# OVH_MONITOR_PROXIES=socks5://user:pass@1.2.3.4:1080,http://user:pass@5.6.7.8:8080

# 兜底全局代理（本地挂代理或通知渠道兜底使用，同样支持 http / https / socks5 / 简写格式）
# OVH_HTTP_PROXY=
# HTTPS_PROXY=

# 其他国内/国际推送渠道（按需填写）
# BARK_URL=
# SERVERCHAN_KEY=
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=
# FEISHU_WEBHOOK=
# DISCORD_WEBHOOK=
# CUSTOM_WEBHOOK_URL=
