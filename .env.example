# ============================================================
# OVH Buyer (OVH Sniper) Environment Template / 环境变量配置模板
# Copy to .env before starting / 复制为 .env 后按需修改
# ============================================================

# Web Console listen port & host / Web 控制台监听端口与地址
PORT=8888
HOST=0.0.0.0

# Container & scheduler default timezone / 容器与定时调度默认基准时区
# Examples: Asia/Shanghai, Europe/Paris, America/New_York, UTC
TZ=Asia/Shanghai
# SCHEDULE_TIMEZONE=Asia/Shanghai

# Optional: Docker Compose image registry / 可选：切换 Docker Hub 或锁定版本号
# OVH_IMAGE=atomboyc/ovh-buyer:latest
# OVH_IMAGE=ghcr.io/atomboyc/ovh-buyer:2.2.0

# Optional: Container UID/GID for ./data ownership / 可选：容器运行与数据卷权限 UID/GID
# PUID=1000
# PGID=1000

# [IMPORTANT] Panel login password & X-API-Key / 【重要】面板登录密码（公网服务器部署务必修改！）
PANEL_PASSWORD=change_me_to_a_strong_password

# Optional: At-rest encryption key for SQLite secrets (OVH keys, proxy passwords, webhooks)
# 可选：数据库凭据静态加密密钥（设置后密钥/代理密码加密落盘；修改后旧密文将无法解密）
# DATA_ENCRYPTION_KEY=your_random_32_char_secret

# Optional: Headless daemon mode (background Sniper + Telegram Bot only, no Web port)
# 可选：无头模式（仅运行后台引擎与 Telegram Bot，不监听 Web 端口）
# HEADLESS=false

# ---------------- Auto-Seed Default OVH Account (Optional / 可选首次启动自动导入) ----------------
# Recommended: use the least-privilege 1-click Token link inside the Web Console "OVH Accounts" tab
# 推荐在 Web 面板「OVH 账号」页点击最小权限一键申请链接（绝不申请删机/重装/重启权限）：
#   EU: https://eu.api.ovh.com/createToken/
#   CA: https://ca.api.ovh.com/createToken/
#   US: https://api.us.ovhcloud.com/createToken/
# OVH_ACCOUNT_NAME=Main-IE
# OVH_ENDPOINT=ovh-eu
# OVH_SUBSIDIARY=IE
# OVH_APP_KEY=
# OVH_APP_SECRET=
# OVH_CONSUMER_KEY=

# ---------------- Notifications & Telegram Bot (Optional / 可选通知渠道) ----------------
# Built-in Long Polling — no public domain, webhook, or SSL cert required!
# TELEGRAM_CHAT_ID supports multiple comma-separated targets and Supergroup Forum Topics:
#   Format 1: -1002134567890/45  (or paste Topic URL https://t.me/c/2134567890/45)
#   Format 2: TELEGRAM_CHAT_ID=-1002134567890 with TELEGRAM_TOPIC_ID=45
# TELEGRAM_ADMIN_IDS: personal User IDs authorized to click buttons inside group topics without duplicate DM alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TOPIC_ID=
# TELEGRAM_ADMIN_IDS=
# TELEGRAM_PROXY=

# ---------------- Monitoring Proxy Pool (Optional / 可选监控专用代理池) ----------------
# Supports comma/newline separation: http://, https:// (nested TLS), socks5://, socks5h://, [scheme://]ip:port:user:pass
# - OVH_MONITOR_PROXIES_POOL: Candidate Master Pool for Two-Tier Auto Proxy Pool (staggered 1-by-1 latency probing)
# - OVH_MONITOR_PROXIES: Static round-robin monitoring proxy list
# OVH_MONITOR_PROXIES_POOL=socks5://user:pass@1.2.3.4:1080,http://user:pass@5.6.7.8:8080
# OVH_MONITOR_PROXIES=socks5://user:pass@1.2.3.4:1080,http://user:pass@5.6.7.8:8080

# Global fallback proxy (used for notifications/FX or when no monitor proxy is set) / 兜底全局代理
# OVH_HTTP_PROXY=
# HTTPS_PROXY=

# Additional Webhook Channels / 其他推送渠道（均支持走代理）
# BARK_URL=
# SERVERCHAN_KEY=
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=
# FEISHU_WEBHOOK=
# DISCORD_WEBHOOK=
# CUSTOM_WEBHOOK_URL=
